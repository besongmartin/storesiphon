# Production environment template. Copy to /var/www/storesiphon/shared/.env and fill in on the server.
# Never commit the real file.
APP_NAME=StoreSiphon
APP_ENV=production
APP_KEY=                       # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://storesiphon.com

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=storesiphon
DB_USERNAME=storesiphon
DB_PASSWORD=

# Redis for cache (per-host throttle locks), sessions and queues
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
QUEUE_CONNECTION=redis

# Export files: local disk on the server (or an S3-compatible disk in the EU)
EXPORTS_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@storesiphon.com
MAIL_FROM_NAME=StoreSiphon

FETCH_USER_AGENT="StoreSiphonBot/1.0 (+https://storesiphon.com/store-owners)"

BTCPAY_URL=
BTCPAY_API_KEY=
BTCPAY_STORE_ID=
BTCPAY_WEBHOOK_SECRET=
BTCPAY_CONFIRMATIONS=1
BTCPAY_INVOICE_EXPIRATION=30

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
